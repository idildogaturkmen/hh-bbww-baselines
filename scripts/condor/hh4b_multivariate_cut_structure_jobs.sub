universe = vanilla
executable = /uscms_data/d3/iturkmen/repos/hh-bbww-baselines/scripts/condor/run_hh4b_multivariate_cut_structure_job.sh
arguments = "$(job_index) $(outer_fold) $(category_id) $(structure_id) $(config) $(input_root) $(output_root) $(expected_repository_head)"

should_transfer_files = NO
getenv = True
request_cpus = 1
request_memory = 6000MB
request_disk = 4000MB
+JobFlavour = "workday"

log = $(log_root)/job_$(job_index).log
output = $(log_root)/job_$(job_index).out
error = $(log_root)/job_$(job_index).err

on_exit_remove = (ExitBySignal == False) && (ExitCode == 0)

queue job_index, outer_fold, category_id, structure_id, config, input_root, output_root, expected_repository_head from $(queue_file)
